{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "tysiac",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-01",
  "workers_dev": true,
  "preview_urls": false,
  "assets": {
    "directory": "../app/dist",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*", "/ws/*"]
  },
  "durable_objects": {
    "bindings": [{ "name": "ROOMS", "class_name": "Room" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["Room"] }],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "tysiac",
      "database_id": "0c636239-a0b0-4ba0-a1c1-ac6227e4e34f",
      "migrations_dir": "migrations"
    }
  ],
  "vars": { "BOT_DELAY_SCALE": "1" },
  "secrets": { "required": ["DEBUG_KEY"] },
  "observability": { "enabled": true }
}
