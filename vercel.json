{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "installCommand": "true",
  "buildCommand": "mkdir -p vercel-redirect && echo moved > vercel-redirect/index.html",
  "outputDirectory": "vercel-redirect",
  "redirects": [
    { "source": "/(.*)", "destination": "https://tysiac-game.pages.dev/$1", "permanent": false }
  ]
}
